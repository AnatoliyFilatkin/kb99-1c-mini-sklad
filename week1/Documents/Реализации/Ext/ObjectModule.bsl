
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ПродажиПоНоменклатуре.Записывать = Истина;
	Движения.ОстаткиНаСкладах.Записывать = Истина;
	Движения.ТоварыПоПартиям.Записывать = Истина;


	  // регистр ПродажиПоНоменклатуре 

	Для Каждого ТекСтрокаТовары Из Товары Цикл
		Движение = Движения.ПродажиПоНоменклатуре.Добавить();
		Движение.Период = Дата;
		Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
		Движение.Склад = Склад;
		Движение.Выручка = ТекСтрокаТовары.Сумма;     
	
	// регистр ОстаткиНаСкладах Расход
		Движение = Движения.ОстаткиНаСкладах.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
		Движение.Склад = Склад;
		Движение.Количество = ТекСтрокаТовары.Количество;
		Движение.Цена = ТекСтрокаТовары.Цена;
	КонецЦикла;
	


    Для Каждого СтрокаТовара Из Товары Цикл

        ОсталосьСписать = СтрокаТовара.Количество;
		
		Запрос = Новый Запрос;
        Запрос.Текст =
		 "ВЫБРАТЬ
		 |	ТоварыПоПартиямОстатки.Партия КАК Партия,
		 |	ТоварыПоПартиямОстатки.КоличествоОстаток КАК КоличествоОстаток
		 |ИЗ
		 |	РегистрНакопления.ТоварыПоПартиям.Остатки(
		 |			&Момент,
		 |			Номенклатура = &Номенклатура
		 |				И Склад = &Склад) КАК ТоварыПоПартиямОстатки
		 |ГДЕ
		 |	ТоварыПоПартиямОстатки.КоличествоОстаток > 0
		 |
		 |УПОРЯДОЧИТЬ ПО
		 |	ТоварыПоПартиямОстатки.Партия.Дата,
		 |	ТоварыПоПартиямОстатки.Партия";

        
        Запрос.УстановитьПараметр("Момент", ЭтотОбъект.Дата);
        Запрос.УстановитьПараметр("Номенклатура", СтрокаТовара.Номенклатура);
        Запрос.УстановитьПараметр("Склад", Склад);

        Выборка = Запрос.Выполнить().Выбрать();

        Пока Выборка.Следующий() И ОсталосьСписать > 0 Цикл

            КоличествоСписать = Мин(ОсталосьСписать,Выборка.КоличествоОстаток);

            Если КоличествоСписать > 0 Тогда

                ДвижениеПартии = Движения.ТоварыПоПартиям.Добавить();

                ДвижениеПартии.ВидДвижения =ВидДвиженияНакопления.Расход;
                ДвижениеПартии.Период = Дата;
                ДвижениеПартии.Номенклатура =СтрокаТовара.Номенклатура;
                ДвижениеПартии.Склад = Склад;
                ДвижениеПартии.Партия = Выборка.Партия;
                ДвижениеПартии.Количество = КоличествоСписать;

                ОсталосьСписать = ОсталосьСписать - КоличествоСписать;

            КонецЕсли;

        КонецЦикла;

        Если ОсталосьСписать > 0 Тогда
            Отказ = Истина;
            Сообщить("Недостаточно остатка по партиям для "+ СтрокаТовара.Номенклатура);
            Возврат;
        КонецЕсли;

	КонецЦикла;


КонецПроцедуры